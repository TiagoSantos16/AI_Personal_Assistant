# Required: put these in personal-assistant-secrets. Never place them in URLs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_ID=
OPENROUTER_API_KEY=
DASHBOARD_PASSWORD=
UI_URL=

# Unevaluated starting heuristics; calibrate on your own notes.
JEV_CONFIDENCE_THRESHOLD=0.70
RAG_MAX_COSINE_DISTANCE=0.45
RAG_JEV_ENABLED=true
RAG_JEV_THRESHOLD=0.65
RAG_CANDIDATE_CHARS=48000
RAG_CONTEXT_CHARS=16000

# Lease exceeds the 600-second CPU worker timeout. Explicit retry only.
JOB_LEASE_SECONDS=900
GENERATION_DEADLINE_SECONDS=300
GENERATIVE_TIMEOUT_SECONDS=45
JEV_TIMEOUT_SECONDS=15
WRITER_OUTPUT_TOKENS=1200
CRITIC_OUTPUT_TOKENS=256
RAG_OUTPUT_TOKENS=800
MAX_MEDIA_DURATION_SECONDS=300
MAX_MEDIA_BYTES=104857600
MAX_TEMP_BYTES=524288000
MAX_MEDIA_ITEMS=16
MAX_IMAGE_DIMENSION=1280
FFMPEG_TIMEOUT_SECONDS=90
REEL_MAX_FRAMES=20

# Optional aggregate USD/second rates for the configured container resources.
# Supply documented rates for your Modal plan, CPU allocation and memory.
# Blank means unavailable, not zero. These estimates exclude shared idle/cold starts.
MODAL_CPU_USD_PER_SECOND=
MODAL_GPU_USD_PER_SECOND=
MODAL_STORAGE_USD_PER_SECOND=

# Existing optional LangSmith support; leave disabled unless already used.
LANGCHAIN_TRACING_V2=
LANGCHAIN_PROJECT=
LANGSMITH_API_KEY=
