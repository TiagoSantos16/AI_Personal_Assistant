# Vars for the Modal Secret named "reel-assistant-secrets".
# Create it with:  modal secret create reel-assistant-secrets
#   TELEGRAM_BOT_TOKEN=...
#   OPENROUTER_API_KEY=...
#   UI_URL=https://your-workspace--reel-assistant-ui.modal.run
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
UI_URL=https://your-workspace--personal-assistant-ui.modal.run


LANGCHAIN_TRACING_V2=
LANGCHAIN_PROJECT=
LANGSMITH_API_KEY=